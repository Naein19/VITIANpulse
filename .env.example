# =============================================================================
# VITPulse — environment
#
# Copy to `.env.local` and fill in. Every variable below is optional for local
# development: with none of them set, the app runs against the seeded in-memory
# store so you can explore every feature immediately.
#
# NEVER commit `.env.local`. Only NEXT_PUBLIC_* values reach the browser.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Used for canonical URLs, OpenGraph tags, the sitemap and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Project settings -> API. Leave blank to run on demo data.
# The anon key is public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security — never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, and rotate it if it ever leaks.
# Used only by operations that already passed a server-side permission check.
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication ----------------------------------------------------------
# Comma-separated email domains allowed to create an account.
ALLOWED_EMAIL_DOMAINS=vitapstudent.ac.in,vitap.ac.in

# Comma-separated emails promoted to SUPER_ADMIN on first sign-in. This is how
# the very first administrator is created without editing the database by hand.
SUPER_ADMIN_EMAILS=

# HMAC key for the demo-mode session cookie. Only used when Supabase is absent,
# but set a random value in any shared environment.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# --- Analytics ---------------------------------------------------------------
# Salt for the daily-rotating visitor hash. Rotating it resets unique counts and
# makes previously stored hashes permanently unlinkable.
# Generate: openssl rand -base64 24
ANALYTICS_SALT=

# --- PYQ Hub integration -----------------------------------------------------
# The existing PYQ application. As of writing it exposes no public REST API and
# serves its data by querying Supabase directly from the browser, so the
# supported integration is to point VITPulse at the same Supabase project with a
# read-only anon key. See src/server/integrations/pyq-hub.ts.
PYQ_HUB_BASE_URL=https://pyqs-hub.vercel.app

# Option 1 (recommended): read the hub's Supabase project directly.
PYQ_HUB_SUPABASE_URL=
PYQ_HUB_SUPABASE_ANON_KEY=
PYQ_HUB_PAPERS_TABLE=papers

# Option 2: if the hub later publishes a REST endpoint, set it here instead.
PYQ_HUB_API_URL=
PYQ_HUB_API_TOKEN=
